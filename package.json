{
  "name": "ninja-recipe-card-exporter",
  "version": "1.0.0",
  "description": "Scrape recipe cards out of Claude.ai conversations and export them as self-contained, interactive HTML recipe cards.",
  "type": "module",
  "bin": {
    "ninja-recipes": "bin/ninja-recipes.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "export": "node bin/ninja-recipes.js",
    "site": "node bin/ninja-recipes.js recipes -o docs --site-title \"Recipes\"",
    "site:pdf": "node bin/ninja-recipes.js recipes -o docs --site-title \"Recipes\" --pdf"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "recipe",
    "claude",
    "export",
    "html",
    "cli",
    "cooking"
  ],
  "license": "MIT",
  "dependencies": {},
  "optionalDependencies": {},
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  }
}
